<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0E1A</item>
        <item name="android:statusBarColor">#0A0E1A</item>
        <item name="android:navigationBarColor">#0A0E1A</item>
        <item name="android:colorAccent">#3ED8FF</item>
        <item name="android:textColorPrimary">#ECF1FF</item>
        <item name="android:textColorSecondary">#8B96B2</item>
        <item name="android:colorControlActivated">#3ED8FF</item>
    </style>

    <style name="DialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:colorAccent">#3ED8FF</item>
        <item name="android:textColorPrimary">#ECF1FF</item>
        <item name="android:textColorSecondary">#8B96B2</item>
        <item name="android:colorBackground">#141B2E</item>
    </style>

</resources>
